# Porta em que o serviço escuta localmente (o reverse proxy da VPS aponta pra cá)
PORT=3000

# --- PoliChat -----------------------------------------------------------
# Segredo de assinatura do webhook (painel da Poli > configuração do webhook).
# PENDENTE (item 1 do plano) — sem isso o serviço roda, mas rejeita tudo por
# segurança caso POLI_WEBHOOK_VERIFY_SIGNATURE=true.
POLI_WEBHOOK_SIGNING_SECRET=
POLI_WEBHOOK_VERIFY_SIGNATURE=true

# Listas de e-mails por papel, separados por vírgula — usadas tanto pro
# filtro de quais mensagens processar quanto pra escolher o espaço do
# Google Chat do alerta (ver abaixo).
POLI_SDR_EMAILS=
POLI_CLOSER_EMAILS=

# --- HubSpot --------------------------------------------------------------
# Private App Token com escopo de escrita em contacts e communications.
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_PORTAL_ID=50231385

# --- Alertas (Google Chat) -------------------------------------------------
# Um espaço por papel — "não encontrado" de SDR e de Closer são avisos com
# gravidade diferente (ver plano). PENDENTE: usuário vai criar os espaços.
GOOGLE_CHAT_WEBHOOK_URL_SDR=
GOOGLE_CHAT_WEBHOOK_URL_CLOSER=

# --- Persistência local (dedupe + retry, não é analytics) -----------------
SQLITE_PATH=./data/queue.sqlite

# --- Logs -------------------------------------------------------------------
LOG_LEVEL=info
