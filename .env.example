# Porta em que o serviço escuta localmente (o reverse proxy da VPS aponta pra cá)
PORT=3000

# --- PoliChat -----------------------------------------------------------
# Segredo de assinatura do webhook (painel da Poli > configuração do webhook).
# PENDENTE (item 1 do plano) — sem isso o serviço roda, mas rejeita tudo por
# segurança caso POLI_WEBHOOK_VERIFY_SIGNATURE=true.
POLI_WEBHOOK_SIGNING_SECRET=
POLI_WEBHOOK_VERIFY_SIGNATURE=true
# Proteções do endpoint (src/webhookGuard.ts): limite por IP (X-Forwarded-For
# do Traefik) com 429 acima disso — deixar ~3× o pico real da Poli —, tamanho
# máximo do corpo, e quantas recusas em 10 min disparam alerta.
WEBHOOK_RATE_LIMIT_PER_MINUTE=5000
WEBHOOK_MAX_BODY=1mb
WEBHOOK_REJECTION_ALERT_THRESHOLD=20

# Listas de e-mails por papel, separados por vírgula — usadas tanto pro
# filtro de quais mensagens processar quanto pra escolher o espaço do
# Google Chat do alerta (ver abaixo).
POLI_SDR_EMAILS=
POLI_CLOSER_EMAILS=

# --- HubSpot --------------------------------------------------------------
# Private App Token com escopo de escrita em contacts e communications.
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_PORTAL_ID=50231385
# Campos do Contato/Negócio (poli_*, id e link do chat na Poli). false = só
# cria a Communication; os campos ficam com o Painel de SDR.
HUBSPOT_FIELDS_ENABLED=true

# --- Alertas (Google Chat) -------------------------------------------------
# Um espaço por papel — "não encontrado" de SDR e de Closer são avisos com
# gravidade diferente (ver plano). PENDENTE: usuário vai criar os espaços.
GOOGLE_CHAT_WEBHOOK_URL_SDR=
GOOGLE_CHAT_WEBHOOK_URL_CLOSER=
# Alertas técnicos (ex.: muitas recusas no webhook). Vazio = só log de erro.
GOOGLE_CHAT_WEBHOOK_URL_OPS=

# --- Persistência local (dedupe + retry, não é analytics) -----------------
SQLITE_PATH=./data/queue.sqlite

# --- Logs -------------------------------------------------------------------
LOG_LEVEL=info

# --- Supabase (espelho das mensagens + base da nota diária) ---
# Projeto em supabase.com → Settings → API. Deixe vazio pra rodar sem eles:
# a integração segue normal, só sem painel e sem nota diária.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Nota diária por contato no HubSpot (gerada ~00:30, do dia anterior).
DAILY_NOTES_ENABLED=true
# Evento cru da Poli em public.raw_events (base do painel de SDR). Só grava o
# que é da equipe de pré-vendas — ver src/poli/rawEventFilter.ts.
RAW_EVENTS_ENABLED=true
# Mensagem enviada com template e sem uuid de autor é disparo do bot pelo app
# token (único sinal disponível no payload da Poli).
POLI_APP_TOKEN_AUTHORLESS_TEMPLATES=true

# --- OpenAI: áudio vira transcrição e imagem vira descrição ------------------
# O texto extraído vai só pro Supabase (painel). No HubSpot a mensagem
# continua com rótulo e link. Vazio = nada é enviado pra OpenAI.
OPENAI_API_KEY=
MEDIA_UNDERSTANDING_ENABLED=true
# Papéis cuja mídia vai pra OpenAI. Hoje só SDR; acrescente CLOSER quando o
# painel de closer existir. Vazio = todos os chats.
MEDIA_OPENAI_ROLES=SDR
# low = imagem em baixa resolução, bem mais barato.
OPENAI_IMAGE_DETAIL=low
# Nomes de modelo em env porque o catálogo da OpenAI muda com frequência.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Vazio = idioma detectado automaticamente (há leads em português e espanhol).
OPENAI_TRANSCRIPTION_LANGUAGE=
OPENAI_VISION_MODEL=gpt-5.4-nano
MEDIA_MAX_MB=20
