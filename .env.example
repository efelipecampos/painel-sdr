# Copie este arquivo para ".env" e preencha. O .env NUNCA vai para o GitHub (está no .gitignore).
# Este .env.example vai, e fica sem valores.

# Supabase (Project Settings → API Keys → aba Legacy API keys / Database)
NEXT_PUBLIC_SUPABASE_URL=https://pabbgxaphooftdsdewmq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # só no servidor (web) e no worker; nunca no navegador
SUPABASE_DB_PASSWORD=             # usada pelo npm run db:push (aplica as migrations)

# Equipe na Poli: e-mails separados por vírgula (mesmas listas da integração + gestores)
POLI_SDR_EMAILS=
POLI_CLOSER_EMAILS=
POLI_MANAGER_EMAILS=
# Robôs da Poli que escrevem com usuário próprio (ex.: Lia): não contam como resposta humana
POLI_BOT_EMAILS=

# Worker (opcional): intervalo de leitura de raw_events e tamanho do lote
WORKER_POLL_SECONDS=30
WORKER_BATCH_SIZE=500

# Alertas no Google Chat (espaço Gestão SDR). Sem a URL, os alertas só vão para o log do worker.
GOOGLE_CHAT_WEBHOOK_URL_ALERTAS=
# Opcional (padrões entre parênteses): endereço do painel e limites em minutos
# PAINEL_URL=https://painel-sdr.camposai.com.br
# ALERTA_FILA_MIN=10  ALERTA_POLI_MIN=30 (horário comercial)  ALERTA_WORKER_MIN=5  ALERTA_HUBSPOT_MIN=30  ALERTA_PAINEL_MIN=5

# Poli (histórico pela API)
POLI_API_BASE_URL=
POLI_API_TOKEN=

# HubSpot: app privado só de leitura (contatos, leads, donos)
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_SYNC_MINUTES=15

# Google Agenda (Fase 10c): projeto "Painel SDR" no Google Cloud da poli.digital (tela de consentimento Interna).
# Credencial OAuth "Aplicativo da Web" com o redirecionamento https://painel-sdr.camposai.com.br/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_KEY=                 # 32 bytes em base64 (openssl rand -base64 32): cifra a autorização dos closers no banco
GOOGLE_CHECK_MINUTES=10

# Score de qualidade (Fase 7): SCORE_IA escolhe a IA (anthropic ou celeris). Sem a chave da IA escolhida, o score não roda.
SCORE_IA=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=                  # ex.: claude-haiku-4-5
CELERIS_API_KEY=
CELERIS_MODEL=celeris-1-magnus    # celeris-1 é mais simples e mesmo preço
# Opcional: CELERIS_RACIOCINIO=sim (raciocina antes: dobra o custo; no teste de 08/10 não melhorou a nota)
# Opcional: SCORE_HORA=05:00 (uma rodada por dia, horário de São Paulo)  SCORE_MAX_POR_RODADA=300

# Deploy (Fase 5)
APP_DOMAIN=
